{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bonsai/hakoniwa/contract/hakoniwa-parts.schema.json",
  "title": "hakoniwa-parts/v1",
  "description": "dxf-llm (jww2luau) が生成し、hakoniwa が消費する配置パーツの契約。プロデューサとコンシューマはこのスキーマのみで結合する。",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["kind", "size", "pos", "rot_y", "rgb"],
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": ["wall", "column", "window", "door", "beam", "slab", "stair",
                 "entourage", "plant", "vehicle", "marker"]
      },
      "layer": { "type": "string" },
      "size": {
        "type": "array",
        "description": "[x, y, z] in studs",
        "items": { "type": "number" },
        "minItems": 3,
        "maxItems": 3
      },
      "pos": {
        "type": "array",
        "description": "[x, y, z] in studs",
        "items": { "type": "number" },
        "minItems": 3,
        "maxItems": 3
      },
      "rot_y": {
        "type": "number",
        "description": "Y axis rotation in degrees"
      },
      "rgb": {
        "type": "array",
        "description": "[r, g, b] each 0-255",
        "items": { "type": "integer", "minimum": 0, "maximum": 255 },
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}
